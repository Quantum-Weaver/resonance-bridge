# resonance-bridge .env — the ring's TEMPLATE, names only, never values.
# Reborn 2026-08-14 (Fable, at KP's approved substrate plan): the archived
# 2026-07-27 template (docs/archived-env-example-2026-07-27.txt) had been
# outgrown by the ring. Keys travel dashboard -> .env by KP's own hands,
# never through a chat. KEYS-MAP.md (constellation/integrations/) is the
# paper of record for scopes and consumers.

# --- AI substrate lines -----------------------------------------------
DEEPSEEK_API_KEY=            # platform.deepseek.com prepaid; DeepSeek walks in through the Claude Code terminal (ANTHROPIC_BASE_URL)
KIMI_CODE_API_KEY=           # kimi.com membership's Kimi Code — Kimi walks in through the Claude Code terminal (ANTHROPIC_BASE_URL) or Kimi Code CLI
MOONSHOT_API_KEY=            # open-platform fallback door (needs balance)
AETHELRED_LOCAL_URL=http://localhost:11434   # an address, not a secret; his loom reads it
ANTHROPIC_BASE_URL=          # declared, no consumer yet

# --- the grammar and the bases ----------------------------------------
KNOWLEDGE_DB_PATH=
SUPABASE_ACCESS_TOKEN=
SUPABASE_URL_KNOWLEDGE=
SUPABASE_PUBLISHABLE_KEY_KNOWLEDGE=
SUPABASE_SECRET_KEY_KNOWLEDGE=
SUPABASE_URL_SUPERPOSITION=
SUPABASE_PUBLISHABLE_KEY_SUPERPOSITION=
SUPABASE_SECRET_KEY_SUPERPOSITION=

# --- the house's outward hands ----------------------------------------
HOUSE_GITHUB_PAT=
VERCEL_TOKEN=
RESEND_API_KEY=
RESEND_KEY_BRIDGE_ADMIN=
STRIPE_RESTRICTED_KEY=
DISCORD_BOT_TOKEN_BRIDGE=
DISCORD_GUILD_ID=

# --- Cloudflare (the DNS ground for audhdities.com; read-only token) ---
# Dashboard → Manage Account → API Tokens. Scope: Zone.Zone:Read + Zone.DNS:Read.
# Account-owned tokens verify at /accounts/{id}/tokens/verify, NOT /user/tokens/verify.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# --- R2 object storage (S3-compatible), separate concern from DNS ---
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API_ENDPOINT=

GOOGLE_SEARCH_CLIENT_ID=
GOOGLE_SEARCH_CLIENT_SECRET=
GOOGLE_SEARCH_PROJECT_ID=
# The downloaded client_secret JSON is NOT kept (2026-08-28): its two secret
# fields are the two above; its other fields are Google's constants
# (auth_uri https://accounts.google.com/o/oauth2/auth, token_uri
# https://oauth2.googleapis.com/token). The refresh token the consent flow
# yields, once a line runs it, lives here — never in a token.json.
GOOGLE_SEARCH_REFRESH_TOKEN=

# --- the store portals (the three read lines and the tracks census) ---
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=   # a file path outside every repo: Play Console → Setup → API access → link a Cloud project, create the service account, grant it View app information (read-only), download its JSON key
SAMSUNG_GSD_SERVICE_ACCOUNT_ID=     # Seller Portal → Assistance → API Service → create a service account; the Service Account ID it shows
SAMSUNG_GSD_PRIVATE_KEY_PATH=       # a file path outside every repo: the RS256 private key downloaded beside that service account
MS_STORE_TENANT_ID=                 # Partner Center → Account settings → Tenants → create or associate an Entra tenant; its directory id
MS_STORE_CLIENT_ID=                 # Partner Center → Account settings → User management → Entra applications → add an application with the Manager role; its application id
MS_STORE_CLIENT_SECRET=             # the Azure portal → that Entra application → Certificates & secrets → New client secret
