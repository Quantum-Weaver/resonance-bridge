# ─── SOVEREIGNTY — NEVER COMMIT ───────────────────────────
*.keystore
*.jks
*.apk*
*.aab
.env
.env.*
!.env.example
*credentials*.json
*service-account*.json
*.pem
*.key
secrets.yaml
secrets.yml
*.db
*.sqlite
*.p12
*.pfx
keystore.properties
